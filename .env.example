# Copy to .env (or run ./scripts/init-env.sh, which fills in random secrets).
# Never commit .env. All values below marked CHANGE_ME must be random.

# --- secrets (generate with: openssl rand -hex 24) ---------------------------
POSTGRES_PASSWORD=CHANGE_ME
LITELLM_DB_PASSWORD=CHANGE_ME
PH_GATEWAY_DB_PASSWORD=CHANGE_ME
PH_PORTAL_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
ANALYZER_API_TOKEN=CHANGE_ME
MOCK_LLM_INSPECT_TOKEN=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME
PORTAL_ADMIN_PASSWORD=CHANGE_ME
# LiteLLM master key and Open WebUI's virtual key must start with "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME
OPENWEBUI_LITELLM_KEY=sk-CHANGE_ME
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts placeholder mappings.
PRIVACY_HUB_MAPPING_KEY=CHANGE_ME
# Key for choosing pseudonyms deterministically (rotate to limit linkability).
PRIVACY_HUB_PSEUDONYM_KEY=CHANGE_ME
# Shared by Open WebUI and the gateway to call the internal OCR service.
OCR_API_KEY=CHANGE_ME
# Gateway -> self-hosted LLM (llama.cpp); OCR service -> Surya model server (vLLM).
LOCAL_LLM_API_KEY=CHANGE_ME
SURYA_VLM_API_KEY=CHANGE_ME

# --- optional: real LLM providers (leave empty to use only the mock) --------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Provider model wildcards users may call, once the key above is set, e.g.
# PROVIDER_MODELS=openai/*,anthropic/*   (then: docker compose up -d bootstrap)
PROVIDER_MODELS=

# --- settings ------------------------------------------------------------------
PORTAL_ADMIN_USER=admin
# Languages loaded by the analyzer (comma separated): hu,en
ANALYZER_LANGUAGES=hu,en
PRIVACY_HUB_DEFAULT_LANGUAGE=hu
# Detection level for organisations without a settings row: standard | maximum
# (maximum also masks unknown words, codes, long numbers; see docs/LIMITATIONS.md)
PRIVACY_HUB_DEFAULT_DETECTION=standard
# Hungarian NER backend: none | spacy:xx_ent_wiki_sm | spacy:hu_core_news_md (HuSpaCy build arg)
#   | spacy:/app/models/hu_nerkor_cnn (scripts/train_nerkor.py). See docs/EVALUATION.md.
ANALYZER_HU_NER=none
PRIVACY_HUB_MAPPING_TTL_S=300
# Extra request parameters to let through (comma separated). Their values are
# NOT inspected or masked: list only parameters that cannot carry free text.
PRIVACY_HUB_EXTRA_ALLOWED_PARAMS=

# --- documents and images (OCR) -------------------------------------------------
# tesseract: default, Apache-2.0 models, CPU only.
# surya: better layout handling, needs an NVIDIA GPU, OCR_WITH_SURYA=1 (image
#   build), the surya-vlm service (--profile surya), SURYA_INFERENCE_URL and
#   OCR_SURYA_LICENSE_ACCEPTED=true. The Surya WEIGHTS are free only for
#   organisations under USD 5M revenue AND funding that do not compete with
#   Datalab; read docs/LIMITATIONS.md before enabling.
OCR_ENGINE=tesseract
OCR_WITH_SURYA=0
OCR_SURYA_LICENSE_ACCEPTED=false
SURYA_INFERENCE_URL=
SURYA_MODEL_DIR=./models/surya
OCR_MAX_PAGES=50
OCR_TIMEOUT_S=180
OCR_MEM_LIMIT=4g
# Documents waiting for the OCR service before it answers "busy".
OCR_MAX_QUEUE=8

# --- self-hosted LLM (docker compose --profile local-llm up -d) -------------------
# GGUF model file in LOCAL_LLM_MODEL_DIR; add local-llm to PROVIDER_MODELS.
LOCAL_LLM_MODEL_DIR=./models/llm
LOCAL_LLM_GGUF=model.gguf
LOCAL_LLM_CTX=8192
LOCAL_LLM_PARALLEL=1
# Local-only mode: refuse every model outside the compose network and cut the
# gateway's internet access. Set all three (see README "Local LLM"):
#   PRIVACY_HUB_LOCAL_ONLY=true
#   COMPOSE_FILE=docker-compose.yml:docker-compose.local-only.yml
#   COMPOSE_PROFILES=local-llm
PRIVACY_HUB_LOCAL_ONLY=false

GATEWAY_PORT=8080
OPENWEBUI_PORT=3000
PUBLIC_OPENWEBUI_URL=http://localhost:3000
# Open WebUI self-registration (the first admin account can always be created).
OPENWEBUI_ENABLE_SIGNUP=false
