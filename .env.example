# Copy to .env (or run ./scripts/init-env.sh, which fills in random secrets).
# Never commit .env. All values below marked CHANGE_ME must be random.

# --- secrets (generate with: openssl rand -hex 24) ---------------------------
POSTGRES_PASSWORD=CHANGE_ME
LITELLM_DB_PASSWORD=CHANGE_ME
PH_GATEWAY_DB_PASSWORD=CHANGE_ME
PH_PORTAL_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
ANALYZER_API_TOKEN=CHANGE_ME
MOCK_LLM_INSPECT_TOKEN=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME
PORTAL_ADMIN_PASSWORD=CHANGE_ME
# LiteLLM master key and Open WebUI's virtual key must start with "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME
OPENWEBUI_LITELLM_KEY=sk-CHANGE_ME
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts placeholder mappings.
PRIVACY_HUB_MAPPING_KEY=CHANGE_ME
# Key for choosing pseudonyms deterministically (rotate to limit linkability).
PRIVACY_HUB_PSEUDONYM_KEY=CHANGE_ME

# --- optional: real LLM providers (leave empty to use only the mock) --------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Provider model wildcards users may call, once the key above is set, e.g.
# PROVIDER_MODELS=openai/*,anthropic/*   (then: docker compose up -d bootstrap)
PROVIDER_MODELS=

# --- settings ------------------------------------------------------------------
PORTAL_ADMIN_USER=admin
# Languages loaded by the analyzer (comma separated): hu,en
ANALYZER_LANGUAGES=hu,en
PRIVACY_HUB_DEFAULT_LANGUAGE=hu
# Hungarian NER backend: none | spacy:xx_ent_wiki_sm | spacy:hu_core_news_md (HuSpaCy build arg)
#   | spacy:/app/models/hu_nerkor_cnn (scripts/train_nerkor.py). See docs/EVALUATION.md.
ANALYZER_HU_NER=none
PRIVACY_HUB_MAPPING_TTL_S=300
# Extra request parameters to let through (comma separated). Their values are
# NOT inspected or masked: list only parameters that cannot carry free text.
PRIVACY_HUB_EXTRA_ALLOWED_PARAMS=
GATEWAY_PORT=8080
OPENWEBUI_PORT=3000
PUBLIC_OPENWEBUI_URL=http://localhost:3000
